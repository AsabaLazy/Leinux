[Unit]
Description=Leinux Daemon Service
After=network.target leinux-core.service
Wants=leinux-core.service

[Service]
Type=simple
WorkingDirectory=/opt/leigod
Environment=LEINUX_HOST=127.0.0.1
Environment=LEINUX_PORT=8088
EnvironmentFile=-/etc/default/leinux
ExecStart=/usr/bin/leinux --daemon
Restart=on-failure
RestartSec=3

StateDirectory=leigod
StateDirectoryMode=0700
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_SYS_NICE CAP_DAC_OVERRIDE
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/leigod/config /var/lib/leigod /sys/fs/cgroup
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
